{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GK Companion",
  "version": "0.1.8",
  "identifier": "fr.dragonir.gkcompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GK Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/cache/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "publisher": "Dragonir",
    "shortDescription": "Crafting planner for Graveyard Keeper 1 & 2",
    "longDescription": "Plan crafts, see the raw materials and crafting tree, browse the research tree, and follow your save's progress. Reads all game data from your own install.",
    "homepage": "https://github.com/Dragonir44/gk-companion",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "license": "MIT",
    "copyright": "\u00a9 2026 Dragonir",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRTIwN0ExNDI2MzM2MTYKUldRV05tTkNvUWZpNzd3cURva3p5REUweDZPUEZ3NFBrN2pxazdzOG1oMHduSXhRemh1ZGlHSlIK",
      "endpoints": [
        "https://github.com/Dragonir44/gk-companion/releases/latest/download/latest.json"
      ]
    }
  }
}
